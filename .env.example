# ============================================================
#  HESA (JARVIS) AI Assistant — Environment Configuration
# ============================================================
#  Copy this file to `.env` and replace placeholder values
#  with your personal API keys and preferences.
#
#  Required keys are marked [REQUIRED].
#  All others are optional with sensible defaults.
# ============================================================

# ── System & Environment Mode ────────────────────────────────
# Application environment: development | staging | production
JARVIS_ENV=production

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
JARVIS_LOG_LEVEL=INFO

# AI routing mode: auto (adaptive fallback) | cloud | local | rules (offline only)
JARVIS_AI_MODE=auto

# Enable privacy mode to disable cloud API calls and telemetry
JARVIS_PRIVACY_MODE=false

# ── Port & Server Configuration ──────────────────────────────
# QML GUI WebSocket port
JARVIS_GUI_PORT=19106

# Diagnostics HTTP endpoint port
JARVIS_DIAGNOSTICS_PORT=19111

# REST API gateway port
JARVIS_API_GATEWAY_PORT=8000

# ── AI Provider API Keys ─────────────────────────────────────
# At least ONE cloud provider key is recommended for full functionality.
# Leave blank to use local-only mode (Ollama / offline rules).

# [REQUIRED for cloud AI] Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Groq cloud inference API key
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API key (GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key (Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Local Ollama LLM Configuration ──────────────────────────
# Ollama server endpoint (must be running locally)
OLLAMA_HOST=http://127.0.0.1:11434

# Default local model for Ollama inference
OLLAMA_MODEL=phi3:latest

# ── Voice & Speech Recognition Settings ─────────────────────
# Wake word trigger phrase
JARVIS_WAKE_WORD=hey_jarvis

# Wake word detection confidence threshold (0.0 – 1.0)
JARVIS_WAKE_THRESHOLD=0.72

# Text-to-Speech provider: edge | pyttsx3
JARVIS_TTS_PROVIDER=edge

# Speech-to-Text engine: faster_whisper | google
JARVIS_STT_ENGINE=faster_whisper

# ── Security & Secret Encryption ────────────────────────────
# Fernet encryption key for local secret storage (auto-generated if empty)
JARVIS_SECRET_KEY=your_secret_encryption_key_here

# ── Spotify Integration (Optional) ──────────────────────────
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ── Release Signing (CI/CD Only) ────────────────────────────
# JARVIS_RELEASE_SIGNING_KEY=your_release_signing_key_here
