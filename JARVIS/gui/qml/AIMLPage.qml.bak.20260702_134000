                    property bool   killSwitchOn:   jarvis.agentsEnabled

                    // ── Bridge connections ───────────────────────────────────
                    Connections {
                        target: jarvis
                        function onAgentStatusChanged(s)    { agentCoreTab.agentStatus = s }
                        function onAgentProgressUpdated(j)  {
                            try {
                                var p = JSON.parse(j)
                                agentCoreTab.agentProgress = "[" + p.agent.toUpperCase() + "] " + p.message
                            } catch(e) {}
                        }
                        function onAgentTaskUpdated(j) {
                            agentCoreTab.lastResultJson = j
                            agentCoreTab.logEntries = JSON.parse(jarvis.getAgentLog())
                        }
                        function onAgentsEnabledChanged(en) { agentCoreTab.killSwitchOn = en }
