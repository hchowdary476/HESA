                }

                // ==========================================
                // TABS 11: RESEARCH LAB
                // ==========================================
                ColumnLayout {
                    spacing: 12
                    Text { text: "RESEARCH LAB (EXPERIMENT TRACKER)"; font.family: JarvisFont.orbitron; font.pixelSize: 14; font.bold: true; color: "#00BFFF" }
                    Rectangle { Layout.fillWidth: true; height: 1; color: "#004b73" }

                    RowLayout {
                        spacing: 12
                        Rectangle {
                            Layout.fillWidth: true; height: 160; color: "#070c18"; border.color: "#004b73"; radius: 4
                            ColumnLayout {
                                anchors.fill: parent; anchors.margins: 12
                                Text { text: "ACTIVE HYPERPARAMETER SWEEPS"; font.family: JarvisFont.orbitron; font.pixelSize: 11; color: "#D6F5FF" }
                                Text { text: "Experiment ID: exp-run-74a  |  Target: Loss minimization"; font.family: "Consolas"; font.pixelSize: 9; color: "#4D94B3" }
                                Text { text: "Best configuration parameters: lr=0.0003, dropout=0.2, batch_size=64"; font.family: "Consolas"; font.pixelSize: 9; color: "#00FF88" }
                                Button { text: "EXPORT BENCHMARK PDF REPORT"; onClicked: jarvis.logReceived.emit("[Research Lab] Exported sweep results report to logs/sweep_report.pdf", "ok") }
                            }
                        }
                    }
                    Item { Layout.fillHeight: true }
                }

                // ==========================================
                // TABS 12: PROMPT LIBRARY
                // ==========================================
                ColumnLayout {
                    spacing: 12
                    Text { text: "PROMPT LIBRARY (SAVED TEMPLATES)"; font.family: JarvisFont.orbitron; font.pixelSize: 14; font.bold: true; color: "#00BFFF" }
                    Rectangle { Layout.fillWidth: true; height: 1; color: "#004b73" }

                    ScrollView {
                        Layout.fillWidth: true; Layout.fillHeight: true; clip: true
                        Column {
                            width: parent.width; spacing: 8
                            Repeater {
                                model: [
                                    { category: "CODING", name: "Python Thread-Safe Singleton Generator", text: "Create a thread-safe singleton double-lock checker class in Python." },
                                    { category: "CYBER SECURITY", name: "Network Scan Packet Filter Rules Analyzer", text: "Analyze the following TCP flags from iptables rules for anomalies." },
                                    { category: "SYSTEM ADMIN", name: "Windows PowerShell CPU Monitor Diagnostics Script", text: "Create a script that lists top CPU intensive services and sends alerts." }
                                ]
                                delegate: Rectangle {
                                    width: parent.width - 10; height: 60; color: "#070c18"; border.color: "#004b73"; radius: 4
                                    ColumnLayout {
                                        anchors.fill: parent; anchors.margins: 6
                                        RowLayout {
                                            Text { text: "[" + modelData.category + "] " + modelData.name; font.family: JarvisFont.orbitron; font.pixelSize: 9; font.bold: true; color: "#00BFFF" }
                                            Item { Layout.fillWidth: true }
                                            Button {
                                                text: "LOAD IN PLAYGROUND"
                                                height: 18
                                                onClicked: {
                                                    aimlRoot.playgroundPrompt = modelData.text
                                                    aimlRoot.activeSubTab = "playground"
                                                    jarvis.logReceived.emit("[Prompt Library] Prompt loaded into sandbox workspace.", "ok")
                                                }
                                            }
                                        }
                                        Text { text: modelData.text; font.family: "Consolas"; font.pixelSize: 8; color: "#4D94B3" }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
