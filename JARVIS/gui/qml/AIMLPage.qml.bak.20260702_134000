// AIMLPage.qml — JARVIS AI & Machine Learning Platform Cockpit (v3.0)

import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

Item {
    id: aimlRoot
    
    // Properties for local states
    property string activeSubTab: "model_hub"
    property string activeModel: jarvis.activeModel || "Gemini 1.5 Pro"
    property string activeProvider: jarvis.activeAI || "Google"
    
    // Dataset management properties
    property string selectedDataset: "user_activity.csv"
    property string datasetStatsJson: "{}"
    property string datasetPreviewJson: "[]"
    property bool analyzingDataset: false

    // Training center properties
    property string trainingFramework: "PyTorch"
    property int trainEpochs: 20
    property real learningRate: 0.001
    property bool isTraining: false
    property var trainingHistory: []
    property int currentEpoch: 0
    property real currentAccuracy: 0.0
    property real currentLoss: 0.0
    property real currentValLoss: 0.0
    property real currentPrecision: 0.0
    property real currentRecall: 0.0
    property real currentF1: 0.0
    property int currentGPU: 0

    // Playground properties
    property string playgroundPrompt: "Optimize my background execution threads, JARVIS."
    property string playgroundComparisonJson: "{}"
    property bool playgroundLoading: false

    // Benchmark leaderboard list
    property var benchmarkData: []

    // Side navigation tabs list
    property var subTabs: [
        { key: "model_hub",      label: "AI MODEL HUB",       desc: "Cloud LLM Providers" },
        { key: "llm_manager",    label: "LOCAL LLM MANAGER",  desc: "Ollama / LM Studio" },
        { key: "dataset_mgr",    label: "DATASET MANAGER",    desc: "Ingestion & Features" },
        { key: "training_ctr",   label: "TRAINING CENTER",    desc: "Model Optimization" },
        { key: "playground",     label: "AI PLAYGROUND",      desc: "Multi-Model Chat" },
        { key: "agents_mgr",     label: "AI AGENTS POOL",     desc: "Specialized Agents" },
        { key: "vision_ai",      label: "COMPUTER VISION",    desc: "YOLO & MediaPipe" },
        { key: "speech_ai",      label: "SPEECH AI",          desc: "Voice & Audio STT" },
        { key: "reinforce_rl",   label: "REINFORCEMENT RL",   desc: "Q-Learning Engine" },
        { key: "benchmark_ctr",  label: "BENCHMARK LAB",      desc: "Live Speed Leaderboard" },
        { key: "research_lab",   label: "RESEARCH LAB",       desc: "Experiment Analytics" },
        { key: "prompt_lib",     label: "PROMPT LIBRARY",     desc: "Instruction Templates" }
    ]

    Component.onCompleted: {
        loadLeaderboard()
    }

    function loadLeaderboard() {
        try {
            aimlRoot.benchmarkData = JSON.parse(jarvis.getBenchmarkLeaderboard())
        } catch(e) {}
    }

    // ══════════════════════════════════════════════════════════════════
    // MAIN LAYOUT: SIDEBAR + MAIN COCKPIT
    // ══════════════════════════════════════════════════════════════════
    Flickable {
        id: flickable
        anchors.fill: parent
        anchors.margins: 16
        contentHeight: Math.max(flickable.height, mainLayout.implicitHeight)
        clip: true
        focus: true

        Keys.onUpPressed: flickable.contentY = Math.max(0, flickable.contentY - 40)
        Keys.onDownPressed: flickable.contentY = Math.min(flickable.contentHeight - flickable.height, flickable.contentY + 40)
        Keys.onPressed: {
            if (event.key === Qt.Key_PageUp) {
                flickable.contentY = Math.max(0, flickable.contentY - flickable.height)
                event.accepted = true
            } else if (event.key === Qt.Key_PageDown) {
                flickable.contentY = Math.min(flickable.contentHeight - flickable.height, flickable.contentY + flickable.height)
                event.accepted = true
            } else if (event.key === Qt.Key_Home) {
                flickable.contentY = 0
                event.accepted = true
            } else if (event.key === Qt.Key_End) {
                flickable.contentY = flickable.contentHeight - flickable.height
                event.accepted = true
            }
        }

        ScrollBar.vertical: ScrollBar {
            id: aimlScrollBar
            policy: ScrollBar.AsNeeded
            contentItem: Rectangle {
                implicitWidth: 6
                implicitHeight: 100
                radius: 3
                color: "#00BFFF"
                opacity: aimlScrollBar.active ? 0.8 : 0.4
                Behavior on opacity { NumberAnimation { duration: 150 } }
            }
            background: Rectangle {
                implicitWidth: 6
                color: "transparent"
            }
        }

        RowLayout {
            id: mainLayout
            width: flickable.width
            spacing: 16

        // ── Sidebar Left (Tab Selector)
        Rectangle {
            Layout.preferredWidth: 260
            Layout.fillHeight: true
            color: "#070c18"
            border.color: "#004b73"
            border.width: 1
            radius: 4

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 12
                spacing: 8

                // Header
                Text {
                    text: "AI & ML COCKPIT"
                    font.family: JarvisFont.orbitron
                    font.pixelSize: 15
                    font.bold: true
                    color: "#00BFFF"
                }

                Rectangle {
                    Layout.fillWidth: true
                    height: 1
                    color: "#004b73"
                }

                // Tab List Item Scroll
                ScrollView {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    clip: true

                    Column {
                        width: parent.width
                        spacing: 4

                        Repeater {
                            model: aimlRoot.subTabs
                            delegate: Rectangle {
                                width: parent.width - 8
                                height: 48
                                radius: 4
                                color: aimlRoot.activeSubTab === modelData.key ? "#0c1f38" 
                                     : tabHover.containsMouse ? "#0a1526" : "transparent"
                                border.color: aimlRoot.activeSubTab === modelData.key ? "#00BFFF" : "transparent"
                                border.width: 1

                                Column {
                                    anchors.left: parent.left
                                    anchors.leftMargin: 12
                                    anchors.verticalCenter: parent.verticalCenter
                                    spacing: 2

                                    Text {
                                        text: modelData.label
                                        font.family: JarvisFont.orbitron
                                        font.pixelSize: 10
                                        font.bold: true
                                        color: aimlRoot.activeSubTab === modelData.key ? "#D6F5FF" : "#4D94B3"
                                    }
                                    Text {
                                        text: modelData.desc
                                        font.family: "Consolas"
                                        font.pixelSize: 8
                                        color: "#2B5E75"
                                    }
                                }

                                MouseArea {
                                    id: tabHover
                                    anchors.fill: parent
                                    hoverEnabled: true
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: aimlRoot.activeSubTab = modelData.key
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Main Cockpit Right (StackLayout panels)
        Rectangle {
            Layout.fillWidth: true
            Layout.fillHeight: true
            color: "#050814"
            border.color: "#004b73"
            border.width: 1
            radius: 4

            StackLayout {
                anchors.fill: parent
                anchors.margins: 16
                currentIndex: getActiveIndex()

                function getActiveIndex() {
                    for(var i=0; i<aimlRoot.subTabs.length; i++) {
                        if(aimlRoot.subTabs[i].key === aimlRoot.activeSubTab) return i
                    }
                    return 0
                }

                // ==========================================
                // TABS 1: AI MODEL HUB
                // ==========================================
                ColumnLayout {
                    spacing: 12
                    
                    RowLayout {
                        Text { text: "AI MODEL HUB"; font.family: JarvisFont.orbitron; font.pixelSize: 14; font.bold: true; color: "#00BFFF" }
                        Item { Layout.fillWidth: true }
                        Text { text: "Active Model: " + aimlRoot.activeModel + " (" + aimlRoot.activeProvider + ")"; font.family: "Consolas"; font.pixelSize: 10; color: "#00FF88" }
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#004b73" }

                    // Grid of LLM Providers
                    GridLayout {
                        columns: 3
                        rowSpacing: 10; columnSpacing: 10
                        Layout.fillWidth: true
                        Layout.fillHeight: true

                        // Card Template Builder
                        Repeater {
                            model: [
                                { name: "ChatGPT 4o", prov: "OpenAI", len: "128k", lat: "165ms", tps: 110, cost: "$0.0025", health: "100%", status: "ONLINE", key: "openai" },
                                { name: "Gemini 1.5 Pro", prov: "Google", len: "2048k", lat: "120ms", tps: 120, cost: "$0.00125", health: "100%", status: "ONLINE", key: "google" },
                                { name: "Claude 3.5 Sonnet", prov: "Anthropic", len: "200k", lat: "180ms", tps: 95, cost: "$0.003", health: "98%", status: "ONLINE", key: "anthropic" },
                                { name: "Grok 3", prov: "xAI", len: "128k", lat: "145ms", tps: 135, cost: "$0.002", health: "100%", status: "ONLINE", key: "grok" },
                                { name: "DeepSeek R1", prov: "DeepSeek", len: "64k", lat: "250ms", tps: 65, cost: "$0.00055", health: "95%", status: "ONLINE", key: "deepseek" },
                                { name: "Ollama (Llama 3)", prov: "Local", len: "8k", lat: "12ms", tps: 45, cost: "$0.00", health: "100%", status: "STANDBY", key: "ollama" },
                                { name: "LM Studio (Mistral)", prov: "Local", len: "16k", lat: "14ms", tps: 38, cost: "$0.00", health: "100%", status: "STANDBY", key: "lmstudio" }
                            ]

                            delegate: Rectangle {
                                Layout.fillWidth: true
                                height: 110
                                color: aimlRoot.activeModel === modelData.name ? "#0c253d" : "#08101f"
                                border.color: aimlRoot.activeModel === modelData.name ? "#00BFFF" : "#004b73"
                                radius: 4

                                ColumnLayout {
                                    anchors.fill: parent; anchors.margins: 10
                                    spacing: 4

                                    RowLayout {
                                        Text { text: modelData.name; font.family: JarvisFont.orbitron; font.pixelSize: 11; font.bold: true; color: "#D6F5FF" }
                                        Item { Layout.fillWidth: true }
                                        Rectangle { width: 45; height: 14; color: "#1b0a0a"; border.color: "#FF4B4B"; radius: 2; visible: modelData.prov === "Local" }
                                    }

                                    RowLayout {
                                        Text { text: "Ctx: " + modelData.len + "  |  Lat: " + modelData.lat; font.family: "Consolas"; font.pixelSize: 9; color: "#4D94B3" }
                                        Item { Layout.fillWidth: true }
                                        Text { text: modelData.status; font.family: "Consolas"; font.pixelSize: 9; color: "#00FF88" }
                                    }

                                    RowLayout {
                                        Text { text: "Speed: " + modelData.tps + " tps  |  Cost: " + modelData.cost; font.family: "Consolas"; font.pixelSize: 9; color: "#4D94B3" }
                                    }

                                    Button {
                                        text: aimlRoot.activeModel === modelData.name ? "✓ ACTIVE" : "SWITCH TO MODEL"
                                        enabled: aimlRoot.activeModel !== modelData.name
                                        Layout.fillWidth: true
                                        height: 22
                                        background: Rectangle {
                                            color: aimlRoot.activeModel === modelData.name ? "#00BFFF" : "#08101a"
                                            border.color: "#00BFFF"
                                            radius: 2
                                            opacity: enabled ? 1.0 : 0.7
                                        }
                                        onClicked: {
                                            aimlRoot.activeModel = modelData.name
                                            aimlRoot.activeProvider = modelData.prov
                                            jarvis.switchActiveModel(modelData.key, modelData.name)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // TABS 2: LOCAL LLM MANAGER
                // ==========================================
                ColumnLayout {
                    spacing: 12
                    Text { text: "LOCAL LLM MANAGER"; font.family: JarvisFont.orbitron; font.pixelSize: 14; font.bold: true; color: "#00BFFF" }
                    Rectangle { Layout.fillWidth: true; height: 1; color: "#004b73" }
                    
                    RowLayout {
                        spacing: 16
                        Rectangle {
                            Layout.fillWidth: true
                            height: 120
                            color: "#070c18"
                            border.color: "#004b73"
                            radius: 4
                            ColumnLayout {
                                anchors.fill: parent; anchors.margins: 12
                                Text { text: "OLLAMA ENGINE"; font.family: JarvisFont.orbitron; font.pixelSize: 12; color: "#D6F5FF" }
                                Text { text: "Connection: localhost:11434  |  Status: ACTIVE"; font.family: "Consolas"; font.pixelSize: 9; color: "#00FF88" }
                                Text { text: "Models Loaded: llama3:8b, mistral:7b, phi3:medium"; font.family: "Consolas"; font.pixelSize: 9; color: "#4D94B3" }
                                Button { text: "RELOAD MODELS"; onClicked: jarvis.logReceived.emit("[Local LLM] Reloaded local Ollama models list.", "ok") }
                            }
                        }
                        Rectangle {
                            Layout.fillWidth: true
                            height: 120
                            color: "#070c18"
                            border.color: "#004b73"
                            radius: 4
                            ColumnLayout {
                                anchors.fill: parent; anchors.margins: 12
                                Text { text: "LM STUDIO HOST"; font.family: JarvisFont.orbitron; font.pixelSize: 12; color: "#D6F5FF" }
                                Text { text: "Connection: localhost:1234  |  Status: STANDBY"; font.family: "Consolas"; font.pixelSize: 9; color: "#808080" }
                                Text { text: "Models Configured: deepseek-coder:6.7b"; font.family: "Consolas"; font.pixelSize: 9; color: "#4D94B3" }
                                Button { text: "CONNECT HOST"; onClicked: jarvis.logReceived.emit("[LM Studio] Initiated local host handshake.", "ok") }
                            }
                        }
                    }
                    Item { Layout.fillHeight: true }
                }

                // ==========================================
                // TABS 3: DATASET MANAGER
                // ==========================================
                ColumnLayout {
                    spacing: 12
                    Text { text: "DATASET MANAGER"; font.family: JarvisFont.orbitron; font.pixelSize: 14; font.bold: true; color: "#00BFFF" }
                    Rectangle { Layout.fillWidth: true; height: 1; color: "#004b73" }
                    
                    RowLayout {
                        spacing: 10
                        Text { text: "Select Dataset:"; font.family: JarvisFont.orbitron; font.pixelSize: 10; color: "#D6F5FF" }
                        ComboBox {
                            id: datasetCombo
                            model: ["user_activity.csv", "system_logs.json", "nlp_prompts.sqlite"]
                            currentIndex: 0
                            onActivated: aimlRoot.selectedDataset = currentText
                        }
                        Button {
                            text: aimlRoot.analyzingDataset ? "ANALYZING..." : "ANALYZE DATASET"
                            onClicked: {
                                aimlRoot.analyzingDataset = true
                                var stats = jarvis.getDatasetStats(aimlRoot.selectedDataset)
                                var prev = jarvis.previewDataset(aimlRoot.selectedDataset)
                                aimlRoot.datasetStatsJson = stats
                                aimlRoot.datasetPreviewJson = prev
                                aimlRoot.analyzingDataset = false
                            }
                        }
                    }

                    // Display Stats
                    Rectangle {
                        Layout.fillWidth: true
                        height: 120
                        color: "#08101a"
                        border.color: "#00BFFF"
                        radius: 4
                        visible: aimlRoot.datasetStatsJson !== "{}"
                        
                        ColumnLayout {
                            anchors.fill: parent; anchors.margins: 10
                            spacing: 2
                            Text { text: "Dataset Metrics Analysis"; font.family: JarvisFont.orbitron; font.pixelSize: 11; color: "#00BFFF" }
                            Text { text: "Total Rows: " + getStat("rows") + "  |  Columns: " + getStat("columns") + "  |  Missing Values: " + getStat("missing_values"); font.family: "Consolas"; font.pixelSize: 9; color: "#D6F5FF" }
                            Text { text: "Outliers Detected: " + getStat("outliers_detected") + "  |  Features: " + getStat("features"); font.family: "Consolas"; font.pixelSize: 9; color: "#D6F5FF" }
                            Text { text: "Normalization: " + getStat("normalization") + "  |  Splits: " + getStat("split_ratio"); font.family: "Consolas"; font.pixelSize: 9; color: "#00FF88" }
                        }
                        function getStat(key) {
                            try {
                                var s = JSON.parse(aimlRoot.datasetStatsJson)
                                return s[key] !== undefined ? s[key] : "N/A"
                            } catch(e) {}
                            return "N/A"
                        }
                    }

                    // Dataset Preview Table
                    Text { text: "Data Sample Preview"; font.family: JarvisFont.orbitron; font.pixelSize: 10; color: "#D6F5FF" }
                    ScrollView {
                        Layout.fillWidth: true
                        Layout.fillHeight: true
                        clip: true
                        ListView {
                            model: getPreviewModel()
                            delegate: RowLayout {
                                width: parent.width
                                Text { text: "ID: " + modelData.id; font.family: "Consolas"; font.pixelSize: 9; color: "#4D94B3"; Layout.preferredWidth: 60 }
                                Text { text: "Age: " + modelData.age; font.family: "Consolas"; font.pixelSize: 9; color: "#D6F5FF"; Layout.preferredWidth: 60 }
                                Text { text: "Income: $" + modelData.income; font.family: "Consolas"; font.pixelSize: 9; color: "#D6F5FF"; Layout.preferredWidth: 100 }
                                Text { text: "Active: " + modelData.active; font.family: "Consolas"; font.pixelSize: 9; color: "#00FF88"; Layout.preferredWidth: 80 }
                                Text { text: "Label: " + modelData.label; font.family: "Consolas"; font.pixelSize: 9; color: "#00BFFF"; Layout.fillWidth: true }
                            }
                        }
                        function getPreviewModel() {
                            try {
                                return JSON.parse(aimlRoot.datasetPreviewJson)
                            } catch(e) {}
                            return []
                        }
                    }
                }

                // ==========================================
                // TABS 4: TRAINING CENTER
                // ==========================================
                ColumnLayout {
                    spacing: 12
                    Text { text: "MODEL TRAINING CENTER"; font.family: JarvisFont.orbitron; font.pixelSize: 14; font.bold: true; color: "#00BFFF" }
                    Rectangle { Layout.fillWidth: true; height: 1; color: "#004b73" }

                    RowLayout {
                        spacing: 10
                        Text { text: "Framework:"; font.family: JarvisFont.orbitron; font.pixelSize: 10; color: "#D6F5FF" }
                        ComboBox {
                            model: ["PyTorch", "TensorFlow", "Scikit-Learn", "XGBoost"]
                            onActivated: aimlRoot.trainingFramework = currentText
                        }
                        Text { text: "Epochs:"; font.family: JarvisFont.orbitron; font.pixelSize: 10; color: "#D6F5FF" }
                        SpinBox {
                            id: epochSpinner
                            from: 10; to: 100; value: 20
                            onValueChanged: aimlRoot.trainEpochs = value
                        }
                        Button {
                            text: aimlRoot.isTraining ? "OPTIMIZING..." : "START TRAINING"
                            onClicked: {
                                aimlRoot.isTraining = true
                                var params = { "epochs": aimlRoot.trainEpochs, "lr": aimlRoot.learningRate }
                                var resJson = jarvis.startMLTraining(aimlRoot.trainingFramework, JSON.stringify(params))
                                aimlRoot.trainingHistory = JSON.parse(resJson)
                                aimlRoot.currentEpoch = aimlRoot.trainingHistory.length
                                var finalVal = aimlRoot.trainingHistory[aimlRoot.currentEpoch - 1]
                                aimlRoot.currentAccuracy = finalVal.accuracy
                                aimlRoot.currentLoss = finalVal.loss
                                aimlRoot.currentValLoss = finalVal.val_loss
                                aimlRoot.currentPrecision = finalVal.precision
                                aimlRoot.currentRecall = finalVal.recall
                                aimlRoot.currentF1 = finalVal.f1
                                aimlRoot.currentGPU = finalVal.gpu
                                aimlRoot.isTraining = false
                            }
                        }
                    }

                    // Display dials/telemetry
                    GridLayout {
                        columns: 4
                        Layout.fillWidth: true
                        
                        Rectangle {
                            Layout.fillWidth: true; height: 60; color: "#081024"; border.color: "#00BFFF"; radius: 4
                            Column {
                                anchors.centerIn: parent; spacing: 4
                                Text { text: "TRAINING LOSS"; font.family: JarvisFont.orbitron; font.pixelSize: 8; color: "#4D94B3" }
                                Text { text: String(aimlRoot.currentLoss); font.family: JarvisFont.orbitron; font.pixelSize: 12; color: "#FF4B4B" }
                            }
                        }
                        Rectangle {
                            Layout.fillWidth: true; height: 60; color: "#081024"; border.color: "#00BFFF"; radius: 4
                            Column {
                                anchors.centerIn: parent; spacing: 4
                                Text { text: "ACCURACY"; font.family: JarvisFont.orbitron; font.pixelSize: 8; color: "#4D94B3" }
                                Text { text: (aimlRoot.currentAccuracy * 100).toFixed(1) + "%"; font.family: JarvisFont.orbitron; font.pixelSize: 12; color: "#00FF88" }
                            }
                        }
                        Rectangle {
                            Layout.fillWidth: true; height: 60; color: "#081024"; border.color: "#00BFFF"; radius: 4
                            Column {
                                anchors.centerIn: parent; spacing: 4
                                Text { text: "F1 SCORE"; font.family: JarvisFont.orbitron; font.pixelSize: 8; color: "#4D94B3" }
                                Text { text: String(aimlRoot.currentF1); font.family: JarvisFont.orbitron; font.pixelSize: 12; color: "#00BFFF" }
                            }
                        }
                        Rectangle {
                            Layout.fillWidth: true; height: 60; color: "#081024"; border.color: "#00BFFF"; radius: 4
                            Column {
                                anchors.centerIn: parent; spacing: 4
                                Text { text: "GPU DEPLOYMENT"; font.family: JarvisFont.orbitron; font.pixelSize: 8; color: "#4D94B3" }
                                Text { text: aimlRoot.currentGPU + "%"; font.family: JarvisFont.orbitron; font.pixelSize: 12; color: "#00FF88" }
                            }
                        }
                    }

                    // Training loss curve canvas plot
                    Rectangle {
                        Layout.fillWidth: true
                        Layout.fillHeight: true
                        color: "#070c18"
                        border.color: "#004b73"
                        radius: 4

                        Canvas {
                            id: trainingPlot
                            anchors.fill: parent
                            anchors.margins: 10
                            
                            // Re-plot when data updates
                            Connections {
                                target: aimlRoot
                                function onTrainingHistoryChanged() { trainingPlot.requestPaint() }
                            }

                            onPaint: {
                                var ctx = getContext("2d")
                                ctx.clearRect(0, 0, width, height)
                                if (aimlRoot.trainingHistory.length === 0) {
                                    ctx.fillStyle = "#4D94B3"
                                    ctx.font = "10px Courier New"
                                    ctx.fillText("Start training to plot loss curves, sir.", 15, 20)
                                    return
                                }
                                // Draw Grid
                                ctx.strokeStyle = "#0d1a30"
                                ctx.lineWidth = 0.5
                                var steps = 5
                                for(var g = 0; g <= steps; g++) {
                                    var y = (height / steps) * g
                                    ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke()
                                }

                                // Plot Accuracy
                                ctx.strokeStyle = "#00FF88"
                                ctx.lineWidth = 2
                                ctx.beginPath()
                                var len = aimlRoot.trainingHistory.length
                                for(var i = 0; i < len; i++) {
                                    var x_pt = (width / (len - 1)) * i
                                    var y_pt = height - (aimlRoot.trainingHistory[i].accuracy * height)
                                    if (i === 0) ctx.moveTo(x_pt, y_pt)
                                    else ctx.lineTo(x_pt, y_pt)
                                }
                                ctx.stroke()

                                // Plot Loss
                                ctx.strokeStyle = "#FF4B4B"
                                ctx.beginPath()
                                for(var j = 0; j < len; j++) {
                                    var lx = (width / (len - 1)) * j
                                    var ly = height - ((aimlRoot.trainingHistory[j].loss / 1.5) * height)
                                    if (j === 0) ctx.moveTo(lx, ly)
                                    else ctx.lineTo(lx, ly)
                                }
                                ctx.stroke()
                            }
                        }
                    }
                }

                // ==========================================
                // TABS 5: AI PLAYGROUND
                // ==========================================
                ColumnLayout {
                    spacing: 12
                    Text { text: "AI PLAYGROUND (MULTI-MODEL)"; font.family: JarvisFont.orbitron; font.pixelSize: 14; font.bold: true; color: "#00BFFF" }
                    Rectangle { Layout.fillWidth: true; height: 1; color: "#004b73" }

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: 8
                        TextField {
                            id: playgroundText
                            placeholderText: "Enter comparative prompt for models..."
                            Layout.fillWidth: true
                            font.pixelSize: 10
                            text: aimlRoot.playgroundPrompt
                            onTextChanged: aimlRoot.playgroundPrompt = text
                        }
                        Button {
                            text: "RUN BENCHMARK COMPARISON"
                            onClicked: {
                                var models = ["ChatGPT 4o", "Claude 3.5 Sonnet", "Gemini 1.5 Pro"]
                                var res = jarvis.getPlaygroundResponse(aimlRoot.playgroundPrompt, JSON.stringify(models))
                                aimlRoot.playgroundComparisonJson = res
                            }
                        }
                    }

                    // 3 Columns comparing outputs
                    RowLayout {
                        Layout.fillWidth: true
                        Layout.fillHeight: true
                        spacing: 10

                        Repeater {
                            model: ["ChatGPT 4o", "Claude 3.5 Sonnet", "Gemini 1.5 Pro"]
                            delegate: Rectangle {
                                Layout.fillWidth: true
                                Layout.fillHeight: true
                                color: "#081024"
