                                                            text: (modelData.elapsed_ms || 0).toFixed(0) + "ms · ~" + (modelData.tokens_estimate || 0) + " tok"
                                                            font.family: "Consolas"; font.pixelSize: 8; color: "#2B5E75"
                                                        }
                                                        Text {
                                                            text: (modelData.status || "?").toUpperCase()
